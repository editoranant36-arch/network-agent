{
  "name": "lan-sentinel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "npm --prefix dashboard run dev",
    "dev:agent": "npm --prefix netlens-agent run dev",
    "build": "npm run build:agent && npm run build:dashboard",
    "build:agent": "npm --prefix netlens-agent install && npm --prefix netlens-agent run build",
    "build:dashboard": "npm --prefix dashboard install && npm --prefix dashboard run build",
    "start": "npm --prefix dashboard run start",
    "start:agent": "npm --prefix netlens-agent run start",
    "start:dashboard": "npm --prefix dashboard run start",
    "agent:node": "npm --prefix netlens-agent run dev",
    "agent:go": "cd agent-go && go run main.go",
    "agent:rust": "cargo run --manifest-path scanner-rs/Cargo.toml --",
    "electron": "electron electron/main.js"
  }
}
